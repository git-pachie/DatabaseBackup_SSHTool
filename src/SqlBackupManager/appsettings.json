{
    "SqlServer": {
        "ConnectionString": "Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=TESTDB;Data Source=.\\;Encrypt=True;TrustServerCertificate=True;",
        "Databases": [
            "TESTDB"
        ],
        "BackupDirectoryOnSqlServer": "D:\\SQLBackups\\Temp",
        "BackupDirectoryFromApp": "\\\\127.0.0.1\\SQLBackups\\Temp",
        "UseNativeCompression": false,
        "CommandTimeoutSeconds": 3600
    },
    "Storage": {
        "LocalZipDirectory": "C:\\SqlBackupManager\\Zip",
        "LogDirectory": "C:\\SqlBackupManager\\Logs"
    },
    "Sftp": {
        "Host": "sftp.example.com",
        "Port": 22,
        "Username": "backupuser",
        "Authentication": "Auto",
        "PrivateKeyPath": null,
        "HostKeyFingerprint": "SHA256:REPLACE_WITH_VERIFIED_FINGERPRINT",
        "RemoteDirectory": "/database-backups/sqlserver/"
    },
    "Email": {
        "Enabled": true,
        "SmtpHost": "smtp.example.com",
        "SmtpPort": 587,
        "Security": "StartTls",
        "From": "sqlbackup@example.com",
        "Recipients": [
            "dba@example.com",
            "it-support@example.com"
        ],
        "SendOnSuccess": true,
        "SendOnFailure": true,
        "AttachLogFile": true
    }
}